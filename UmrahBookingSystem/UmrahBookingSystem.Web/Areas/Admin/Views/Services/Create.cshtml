@model UmrahBookingSystem.Web.Areas.Admin.ViewModels.Services.CreateServiceViewModel

@{
    ViewData["Title"] = "New service";
}

<form asp-action="Create" method="post" class="card card-body" style="max-width: 640px">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="ServiceName" class="form-label">Service name</label>
        <input asp-for="ServiceName" class="form-control" maxlength="250" />
        <div class="form-text">For example: flight ticket, visa, meals.</div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
    </div>
</form>