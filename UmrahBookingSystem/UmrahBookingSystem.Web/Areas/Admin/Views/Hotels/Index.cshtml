@model IEnumerable<UmrahBookingSystem.Application.DTOs.Hotels.HotelDto>

@{
    ViewData["Title"] = "Hotels";
}

<div class="d-flex justify-content-end mb-3">
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> New hotel
    </a>
</div>

@if (ViewData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (!Model.Any())
{
    <p class="text-muted">No hotels yet.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th style="width: 80px"></th>
                <th>Name</th>
                <th>Stars</th>
                <th>City</th>
                <th class="text-end">Actions</th> 
            </tr>
        </thead>
        <tbody>
            @foreach (var hotel in Model)
            {
                <tr class="align-middle">
                    <td>
                        @if (hotel.ThumbnailUrl is not null)
                        {
                            <img src="@hotel.ThumbnailUrl" alt="@hotel.HotelName"
                                 width="64" height="48" loading="lazy"
                                 class="rounded" style="object-fit: cover" />
                        }
                        else
                        {
                            <div class="bg-light rounded d-flex align-items-center justify-content-center text-muted"
                                 style="width: 64px; height: 48px">
                                <i class="bi bi-image"></i>
                            </div>
                        }
                    </td>
                    <td>@hotel.HotelName</td>
                    <td>@hotel.Stars</td>
                    <td>@hotel.CityName</td>
                    <td class="text-end">
                        <a asp-action="Edit" asp-route-id="@hotel.Id" class="btn btn-sm btn-outline-primary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@hotel.Id" class="btn btn-sm btn-outline-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}